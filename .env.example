# =============================================================================
# StockSentinel Environment Variables Template
# Copy this file to .env and adjust variables for your local setup.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16)
# -----------------------------------------------------------------------------
POSTGRES_DB=stocksentinel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stocksentinel
DATABASE_SSL=false

# -----------------------------------------------------------------------------
# Redis Configuration (Redis 7)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Screener Engine & Ingestion (Python)
# -----------------------------------------------------------------------------
PYTHON_ENV=development
DATA_DIR=./screener/data
PARQUET_DIR=./screener/data/parquet
UNIVERSE_SEED_FILE=./screener/data/universe/russell3000_sp1500.json
BATCH_SIZE=50
RATE_LIMIT_DELAY=1.5
MAX_RETRIES=4

# -----------------------------------------------------------------------------
# Telegram Bot Alerting System
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
WEB_APP_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Backend REST API Service (Node.js / Express)
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Frontend Web Application (React / Vite)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000
